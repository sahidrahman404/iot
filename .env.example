# Copy to .env (mise loads it automatically). Never commit .env.
DEVICE_API_KEY=change-me-to-a-long-random-string
DB_PATH=data/iot.duckdb
TZ_NAME=Asia/Jakarta
REPORT_INTERVAL=60
CHART_HOURS=24
# Soil moisture % thresholds
SOIL_DRY_BELOW=30
SOIL_WET_ABOVE=80
# MQ-135 raw ADC thresholds (0-4095): calibrate against your clean-air baseline
AIR_MODERATE_ABOVE=1500
AIR_POOR_ABOVE=2500
